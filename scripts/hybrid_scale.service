[Unit]
Description=Hybrid Athlete - Insmart Scale Bluetooth Bridge
After=network.target bluetooth.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/pi_zero_scale_bridge.py --app-url http://YOUR_PC_IP:3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
